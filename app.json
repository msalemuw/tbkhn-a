{
  "expo": {
    "name": "tabkheen A",
    "slug": "tabkheena",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "tbkhna",
    "userInterfaceStyle": "light",
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#28303a",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_MEDIA_LOCATION"
      ],
      "package": "com.tabkheen.a"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "sounds": [
            "./assets/sounds/new-order.wav"
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#28303a",
          "image": "./assets/images/splash-logo.png",
          "imageWidth": 260,
          "android": {
            "image": "./assets/images/splash-logo-android.png",
            "imageWidth": 288
          }
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "tabkheen A uses your location to show how far each pickup point is and to set your own pickup point.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "tabkheen A uses your photos so you can add pictures of your dishes and your profile.",
          "cameraPermission": "tabkheen A uses the camera so you can take pictures of your dishes.",
          "microphonePermission": false
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "tabkheen A uses the camera so you can take pictures of your dishes.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "tabkheen A shows your recent photos so you can pick a picture of your dish.",
          "savePhotosPermission": false,
          "isAccessMediaLocationEnabled": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "ios": {
      "bundleIdentifier": "com.tabkheen.a",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleLocalizations": [
          "en",
          "ar"
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "41a8e2cb-318d-4d98-a257-d146f0398c98"
      }
    },
    "owner": "tabkheen.a-team",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/41a8e2cb-318d-4d98-a257-d146f0398c98"
    }
  }
}
